# GSP Environment Configuration
# Copy this file to .env and fill in values if you need to override defaults.
# The defaults in settings.py already point to the bundled binaries in GSP/bin/
# and GSP/gsp_web/ncbi-blast-2.16.0+/bin/, so for local use you usually
# don't need to set anything here.

# ── Django ─────────────────────────────────────────────────────────────────
# Generate a secret key with: python3 -c "import secrets; print(secrets.token_hex(50))"
# DJANGO_SECRET_KEY=your-secret-key-here

# Set to false in production
# DJANGO_DEBUG=true

# Comma-separated list of allowed hostnames (production only)
# DJANGO_ALLOWED_HOSTS=yourserver.example.com,192.168.1.100

# ── Binary paths (only needed if using system-installed tools) ─────────────
# GSP_MUSCLE_PATH=/path/to/muscle5
# GSP_PRIMER3_PATH=/path/to/primer3_core
# GSP_BLASTN_PATH=/path/to/blastn
# GSP_BLASTDBCMD_PATH=/path/to/blastdbcmd

# ── BLAST database root (only needed if databases are stored elsewhere) ─────
# GSP_BLAST_DB_ROOT=/path/to/blast_db
